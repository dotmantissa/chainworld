{
  "name": "chainworld",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run contracts:test && npm run build",
    "contracts:build": "node node_modules/@foundry-rs/forge/bin.mjs build",
    "contracts:test": "node node_modules/@foundry-rs/forge/bin.mjs test",
    "metadata:validate": "tsx --env-file=.env scripts/validate-manifest.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate-db.ts",
    "test:browser": "playwright test",
    "test:database": "tsx --env-file=.env scripts/test-database.ts",
    "test:api": "tsx --env-file=.env scripts/test-api.ts",
    "metadata:fetch": "tsx --env-file=.env scripts/fetch-chog-source.ts",
    "test:world-database": "tsx --env-file=.env scripts/test-world-database.ts",
    "metadata:audit": "tsx scripts/audit-source.ts",
    "faucet:enable": "tsx --env-file=.env scripts/enable-faucet.ts",
    "faucet:check": "tsx --env-file=.env scripts/enable-faucet.ts --check",
    "faucet:configure": "tsx --env-file=.env scripts/enable-faucet.ts --configure",
    "test:indoor-database": "tsx --env-file=.env scripts/test-indoor-database.ts",
    "households:audit": "tsx scripts/audit-households.ts",
    "test:household-database": "tsx --env-file=.env scripts/test-household-database.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@openzeppelin/contracts": "5.1.0",
    "@tanstack/react-query": "^5.62.7",
    "connectkit": "^1.9.2",
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@foundry-rs/forge": "^1.4.4",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
