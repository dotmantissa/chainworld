# Shared server authority (never prefix the connection string with VITE_).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
APP_ORIGIN=http://localhost:5175
VITE_SHARED_WORLD=true
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Use the same NFT collection on the server and in the browser.
CHOG_ADDRESS=0x9fcC2FB7487A3530809f45DFD9bb419EA2E0aF17
VITE_CHOG_ADDRESS=0x9fcC2FB7487A3530809f45DFD9bb419EA2E0aF17

# Live source-mapped faucet and V2 registry on Monad Testnet (10143).
# The historical VITE_REGISTRY_ADDRESS is incompatible with the V2 ABI.
REGISTRY_V2_ADDRESS=0xA4aB8dbc0b3213C2d80af677bD7B4b5f259BdD0f
VITE_REGISTRY_V2_ADDRESS=0xA4aB8dbc0b3213C2d80af677bD7B4b5f259BdD0f
FAUCET_ADDRESS=0x9fcC2FB7487A3530809f45DFD9bb419EA2E0aF17
VITE_FAUCET_ADDRESS=0x9fcC2FB7487A3530809f45DFD9bb419EA2E0aF17
METADATA_HOSTS=ipfs.io,gateway.pinata.cloud,ipfs.filebase.io,dweb.link
